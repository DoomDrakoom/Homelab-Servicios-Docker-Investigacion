# =========================================
# Variables de entorno / secretos genéricos
# =========================================
*.env
.env.*
**/.env
**/secrets/
**/secret/
*.key
*.pem
*.crt
*.pfx
*.p12
*credentials*
*password*
*token*

# =========================================
# Claves SSH / GPG
# =========================================
**/.ssh/
id_rsa*
id_ed25519*
id_ecdsa*
known_hosts
authorized_keys
*.gpg
*.asc

